{
  "name": "lumen",
  "version": "1.0.0",
  "private": true,
  "description": "Lumen: a live, remote-friendly home screen for LG webOS TVs, with Bluetooth speaker control, Spotify, usage stats and a Home-button service.",
  "license": "MIT",
  "author": "Sandanu Hewage",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sandanu06/lumen.git"
  },
  "homepage": "https://github.com/Sandanu06/lumen#readme",
  "bugs": {
    "url": "https://github.com/Sandanu06/lumen/issues"
  },
  "keywords": [
    "webos",
    "lg-tv",
    "smart-tv",
    "launcher",
    "dashboard",
    "spotify",
    "bluetooth",
    "tv-app"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "setup": "node tools/setup.js",
    "sync": "node tools/sync-apps.js",
    "art": "python3 tools/make-art.py",
    "wallpapers": "python3 tools/make-wallpapers.py",
    "icons": "python3 tools/make-icons.py",
    "build": "node tools/build.js",
    "deploy": "node tools/build.js --deploy",
    "spotify": "node tools/spotify-auth.js",
    "lint": "node tools/lint.js",
    "test": "node --test tests/*.test.js",
    "check": "npm run lint && npm test",
    "docs:media": "node tools/docs-media.js"
  },
  "dependencies": {
    "lgtv2": "^2.1.0"
  },
  "devDependencies": {
    "@webos-tools/cli": "^3.2.6",
    "pngjs": "^7.0.0"
  }
}
